# Copy this file to .env and fill in your actual credentials

# Your Akave access key
AKAVE_ACCESS_KEY=your_access_key_here

# Your Akave secret key
AKAVE_SECRET_KEY=your_secret_key_here

# Akave O3 endpoint URL
AKAVE_ENDPOINT_URL=https://o3-rc2.akave.xyz

# Your Akave bucket name
AKAVE_BUCKET_NAME=your_bucket_name_here
